{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=Mylife_DB;Username=postgres;Password=YOUR_PASSWORD"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.AspNetCore.Hosting": "Information",
      "Microsoft.AspNetCore.Routing": "Information"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "SecretKey": "YOUR_SECRET_KEY_AT_LEAST_32_CHARACTERS",
    "Issuer": "LoginApp",
    "Audience": "LoginAppUsers",
    "AccessTokenSeconds": 30,
    "RefreshTokenMinutes": 2
  },
  "Authentication": {
    "Google": {
      "ClientId": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
      "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET"
    }
  },
  "GoogleDrive": {
    "WebAppUrl": "YOUR_GOOGLE_APPS_SCRIPT_WEB_APP_URL",
    "FolderId": "",
    "LocalCachePath": "Storage/Avatars"
  }
}
