@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-5">
    <div class="card shadow p-4">
        <h2>Xin chào, <span class="text-primary">@ViewBag.UserEmail</span></h2>
        <p class="text-muted">Bạn đang đăng nhập với phiên có Access Token (2 phút) và Refresh Token (10 phút).</p>
        
        <div class="alert alert-info">
            <strong>Cơ chế hoạt động:</strong>
            <ul>
                <li>Access Token sống <strong>2 phút</strong>: Dùng để xác thực mọi yêu cầu.</li>
                <li>Refresh Token sống <strong>10 phút</strong>: Dùng để cấp Access Token mới mà không cần gõ lại mật khẩu.</li>
            </ul>
        </div>

        <div class="d-flex gap-2">
            <button id="btnRefreshToken" class="btn btn-warning">Thử Refresh Token Thủ Công</button>
            <form asp-action="Logout" method="post">
                <button type="submit" class="btn btn-danger">Đăng Xuất</button>
            </form>
        </div>
        <div id="statusResult" class="mt-3"></div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('btnRefreshToken').addEventListener('click', async () => {
            const resultDiv = document.getElementById('statusResult');
            try {
                const response = await fetch('/Account/RefreshToken', {
                    method: 'POST'
                });
                const data = await response.json();
                if (response.ok) {
                    resultDiv.innerHTML = `<div class="alert alert-success">${data.message}</div>`;
                } else {
                    resultDiv.innerHTML = `<div class="alert alert-danger">${data.message}</div>`;
                }
            } catch (err) {
                resultDiv.innerHTML = `<div class="alert alert-danger">Lỗi kết nối.</div>`;
            }
        });

        // Tự động gia hạn Access Token sau mỗi 1.8 phút (108 giây) trước khi hết hạn 2 phút
        setInterval(async () => {
            await fetch('/Account/RefreshToken', { method: 'POST' });
            console.log("Access Token đã được tự động làm mới ngầm.");
        }, 108 * 1000);
    </script>
}